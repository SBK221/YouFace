{
  "name": "youface-staging",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "worker": "node worker/index.js",
    "migrate": "node server/migrate.js",
    "security:check": "node scripts/security-check.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify": "npm run build:clients && npm run security:check && npm run audit:deps && npm test",
    "android:add": "cap add android",
    "sync:android": "cap sync android",
    "open:android": "cap open android",
    "sync:ios": "cap sync ios",
    "open:ios": "cap open ios",
    "android:harden": "node scripts/harden-android.mjs",
    "preflight:android": "npm run verify && npx cap sync android && npm run android:harden",
    "storage:init": "node scripts/init-s3.mjs",
    "build:clients": "esbuild src/identity-client.js --bundle --minify --format=iife --platform=browser --outfile=public/identity.js && esbuild src/billing-client.js --bundle --minify --format=iife --platform=browser --outfile=public/billing.js",
    "build:runtime": "node scripts/write-runtime-config.mjs",
    "build": "npm run build:runtime && npm run build:clients",
    "stripe:bootstrap": "node scripts/bootstrap-stripe.mjs",
    "firebase:preflight": "node scripts/firebase-preflight.mjs",
    "firebase:fingerprints": "node scripts/android-fingerprints.mjs",
    "native:id:check": "node scripts/native-id-check.mjs",
    "preflight:firebase": "npm run native:id:check && npm run firebase:preflight"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/lib-storage": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@revenuecat/purchases-capacitor": "^13.2.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-raw-body": "^5.0.0",
    "file-type": "^22.0.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.4",
    "pg-mem": "^3.0.14"
  }
}
