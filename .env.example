NODE_ENV=development
HOST=0.0.0.0
PORT=4173
APP_ORIGINS=http://localhost:4173,capacitor://localhost
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Firebase Authentication — Phone + Google + Gmail/password
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json
FIREBASE_CHECK_REVOKED=true
BOOTSTRAP_ADMIN_FIREBASE_UID=
FIREBASE_PUBLIC_API_KEY=
FIREBASE_PUBLIC_AUTH_DOMAIN=
FIREBASE_PUBLIC_APP_ID=
FIREBASE_PUBLIC_MESSAGING_SENDER_ID=
IOS_GOOGLE_AUTH_ENABLED=false
PUBLIC_API_BASE_URL=

DATABASE_URL=postgres://youface:youface_dev_password@localhost:5432/youface
REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=youface-media
S3_ACCESS_KEY=youface
S3_SECRET_KEY=youface_minio_password
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
S3_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=524288000

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WORKER_POLL_MS=1000

# Web creator memberships + creator payouts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_CONNECT_COUNTRY_DEFAULT=FR
STRIPE_APPLICATION_FEE_PERCENT=10
BILLING_SUCCESS_URL=http://localhost:4173/#creator
BILLING_CANCEL_URL=http://localhost:4173/#creator
CONNECT_RETURN_URL=http://localhost:4173/#creator
CONNECT_REFRESH_URL=http://localhost:4173/#creator

# Native store billing through RevenueCat
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_HMAC_SECRET=
REVENUECAT_WEBHOOK_TOLERANCE_SECONDS=300
REVENUECAT_PREMIUM_ENTITLEMENT=youface_premium
REVENUECAT_CREDIT_PRODUCTS_JSON={"youface_credits_100":100,"youface_credits_550":550,"youface_credits_1200":1200}
TIP_PLATFORM_FEE_PERCENT=10
