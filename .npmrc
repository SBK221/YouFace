# Resilience for installs over slow/flaky networks (CI and dev).
# Mitigates npm "Exit handler never called!" crashes caused by registry timeouts
# when fetching the large dependency tree (AWS SDK, Firebase, Stripe).
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
fund=false
audit=false
